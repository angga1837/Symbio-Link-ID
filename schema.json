{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SymbioLink_Transaction",
  "type": "object",
  "properties": {
    "sender_factory_id": {
      "type": "string",
      "description": "ID unik pabrik pengirim limbah"
    },
    "material_type": {
      "type": "string",
      "description": "Jenis material sisa (misal: Sludge Tembaga)"
    },
    "volume_kg": {
      "type": "number",
      "description": "Berat material dalam kilogram"
    },
    "ph_level": {
      "type": "number",
      "description": "Tingkat keasaman untuk prediksi ML"
    }
  },
  "required": ["sender_factory_id", "material_type", "volume_kg"],
  "system_outputs": {
    "ml_purity_score": "float (0.0 to 1.0)",
    "optimization_status": "string (MATCH_FOUND | PENDING)",
    "blockchain_tx_hash": "string"
  }
}