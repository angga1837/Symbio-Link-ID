# ======================================
# Engine Configuration for Railway
# ======================================
# Copy this to .env and fill in your values for local development
# Railway will auto-inject most of these via environment variables

# DATABASE_URL
# Railway format: postgresql://user:password@host:port/database
# Example: postgresql+asyncpg://symbio:symbio_enterprise_2026@postgres:5432/symbio_enterprise
# If not set, defaults to localhost:5433 for local development
# DATABASE_URL=postgresql+asyncpg://symbio:symbio_enterprise_2026@localhost:5433/symbio_enterprise

# CORS Configuration
# For local development:
# CORS_ALLOW_ORIGINS=http://localhost:3000
# 
# For Railway production (adjust to your frontend domain):
# CORS_ALLOW_ORIGINS=https://your-frontend.railway.app
#
# Or use FRONTEND_URL (same effect):
# FRONTEND_URL=https://your-frontend.railway.app

# Mock Data Seeding (use with caution in production)
# SEED_MOCK_DATA=false
# SEED_MOCK_FORCE=false
